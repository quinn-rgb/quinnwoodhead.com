---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import portrait from '../assets/life/anthropic-day-one.jpg';
import signature from '../assets/brand/signature-ink.png';

// Ring positions are percentages of the viewport. The buoys can be dragged
// anywhere from here; these are only where they start.
const buoys = [
	{ href: '/projects',     label: 'Projects',  x: 50, y: 15 },
	{ href: '/athletics',    label: 'Athletics', x: 81, y: 50 },
	{ href: '/gallery',      label: 'Gallery',   x: 50, y: 85 },
	{ href: '/coach-portal', label: 'Coaching',  x: 19, y: 50 },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Quinn Woodhead" description="Quinn Woodhead." />
	</head>
	<body data-page="hub">
		<canvas id="water" aria-hidden="true"></canvas>

		<main class="stage" id="stage">
			<div class="field" id="field">
			<section class="centre">
				<figure class="face">
					<Image src={portrait} alt="Quinn Woodhead" widths={[300, 600]} sizes="150px" loading="eager" />
				</figure>
				<figure class="sign">
					<Image src={signature} alt="Quinn Woodhead" widths={[400, 800]} sizes="300px" loading="eager" />
				</figure>
				<p>GTM @ Anthropic in San Francisco</p>
				<a class="more" href="/about">Full bio &rarr;</a>
			</section>

			{buoys.map((b) => (
				<a
					class="buoy"
					href={b.href}
					data-slug={b.href}
					style={`--x: ${b.x}; --y: ${b.y}`}
				>
					<span class="float">
						<span class="ball"></span>
						<span class="glow"></span>
					</span>
					<span class="tag">{b.label}</span>
				</a>
			))}
			</div>
		</main>

		<button class="reset" id="reset" hidden>Reset buoys</button>

		<style>
			html, body { height: 100%; overflow: hidden; }
			body { background: #070b16; }

			#water {
				position: fixed; inset: 0;
				width: 100%; height: 100%;
				display: block; z-index: 0;
				opacity: 0;
				transition: opacity 900ms ease;
			}
			#water.lit { opacity: 1; }

			/* fallback if WebGL is unavailable — never a black screen */
			body::before {
				content: '';
				position: fixed; inset: 0; z-index: 0;
				background: radial-gradient(130% 100% at 50% 100%, #1f3a6d 0%, #14213d 42%, #070b16 78%);
			}

			.field {
				position: absolute; inset: 0;
				will-change: transform;
			}
			.stage {
				position: fixed; inset: 0;
				z-index: 1;
				cursor: grab;
				max-width: none;
				padding: 0;
				transform-origin: var(--ox, 50%) var(--oy, 50%);
				transition: transform 760ms cubic-bezier(.5, 0, .75, 0), opacity 760ms ease;
			}
			body.diving .stage { transform: scale(3.4); opacity: 0; }
			body.panning .stage { cursor: grabbing; }
			body.panning .float { animation-play-state: paused; }

			/* ── centre ───────────────────────────────────────────── */
			.centre {
				position: absolute;
				left: 50%; top: 50%;
				transform: translate(-50%, -50%);
				width: min(400px, 82vw);
				text-align: center;
			}
			.face {
				margin: 0 auto 18px;
				width: 128px; height: 128px;
				border-radius: 50%;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.22);
				box-shadow: 0 10px 40px rgba(7, 11, 22, 0.6);
			}
			.face :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }

			.centre h1 {
				font-size: clamp(24px, 3.2vw, 32px);
				margin: 0;
				letter-spacing: 0.01em;
				text-shadow: 0 2px 30px rgba(7, 11, 22, 0.8);
			}
			.centre h1::after { display: none; }

			.sign { margin: 4px auto 18px; width: min(300px, 70vw); }
			/* The stage is a fixed, z-indexed stacking context, so mix-blend-mode
			   has nothing to blend against here. This asset carries real alpha. */
			.sign :global(img) {
				width: 100%; height: auto; display: block;
				opacity: 0.92;
			}

			.centre p {
				font-family: var(--mono);
				font-size: 11px;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				line-height: 1.6;
				color: var(--fg-2);
				margin: 0 0 16px;
				max-width: none;
				text-shadow: 0 1px 18px rgba(7, 11, 22, 0.85);
			}
			.more {
				font-family: var(--mono);
				font-size: 10px;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--fg-3);
				text-decoration: none;
			}
			.more:hover { color: var(--fg); text-decoration: none; }

			/* ── buoys ────────────────────────────────────────────── */
			.buoy {
				position: absolute;
				left: calc(var(--x) * 1%);
				top: calc(var(--y) * 1%);
				transform: translate(-50%, -50%);
				width: 96px;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 10px;
				text-decoration: none;
				cursor: grab;
				touch-action: none;
				-webkit-user-select: none;
				user-select: none;
				z-index: 2;
			}
			.buoy:active { cursor: grabbing; }
			.buoy.dragging .float { animation-play-state: paused; }

			.float {
				position: relative;
				width: 72px; height: 72px;
				display: block;
				animation:
					bob  var(--bob, 5s)  ease-in-out infinite,
					sway var(--sway, 9s) ease-in-out infinite;
				animation-delay: var(--delay, 0s), var(--delay, 0s);
				transition: filter 300ms ease;
			}
			.buoy:hover .float { filter: brightness(1.12); }
			.buoy:hover .ball { box-shadow:
				0 14px 34px rgba(7, 11, 22, 0.7),
				inset 0 -9px 18px rgba(10, 20, 40, 0.42),
				inset 0 6px 10px rgba(255, 255, 255, 0.6),
				0 0 26px rgba(109, 163, 255, 0.5); }

			/* every buoy identical — the label is the only difference */
			.ball {
				position: absolute; inset: 0;
				border-radius: 50%;
				background:
					radial-gradient(circle at 33% 26%, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.3) 16%, transparent 44%),
					linear-gradient(to bottom,
						#f4f7fb 0%, #e6edf6 40%,
						#6da3ff 40%, #4b86ea 58%,
						#cfdcec 58%, #93a8c2 100%);
				box-shadow:
					0 10px 28px rgba(7, 11, 22, 0.66),
					inset 0 -9px 18px rgba(10, 20, 40, 0.42),
					inset 0 6px 10px rgba(255, 255, 255, 0.5);
			}
			.glow {
				position: absolute;
				left: 50%; bottom: -16px;
				transform: translateX(-50%);
				width: 86px; height: 22px;
				border-radius: 50%;
				background: radial-gradient(ellipse, rgba(109, 163, 255, 0.46) 0%, transparent 70%);
				filter: blur(5px);
				transition: opacity 300ms ease;
				opacity: 0.75;
			}
			.buoy:hover .glow { opacity: 1; }

			.tag {
				font-family: var(--mono);
				font-size: 10px;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--fg-2);
				text-shadow: 0 1px 14px rgba(7, 11, 22, 0.9);
				transition: color 240ms ease;
			}
			.buoy:hover .tag { color: var(--fg); }

			body.diving .buoy:not(.chosen) { opacity: 0; transition: opacity 320ms ease; }
			.buoy.chosen .float { transform: scale(2.1); transition: transform 700ms cubic-bezier(.5,0,.75,0); }
			.buoy.chosen .tag { opacity: 0; transition: opacity 260ms ease; }

			@keyframes bob {
				0%, 100% { translate: 0 -5px; }
				50%      { translate: 0 5px; }
			}
			/* a slow list, so they never look pinned to the water */
			@keyframes sway {
				0%, 100% { rotate: -5deg; }
				50%      { rotate: 5deg; }
			}

			.reset {
				position: fixed;
				right: 22px; bottom: 20px;
				z-index: 3;
				background: transparent;
				border: 1px solid var(--line);
				border-radius: 20px;
				padding: 7px 14px;
				font-family: var(--mono);
				font-size: 9.5px;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--fg-3);
				cursor: pointer;
				transition: color 200ms ease, border-color 200ms ease;
			}
			.reset:hover { color: var(--fg); border-color: var(--line-2); }

			/* ── phone: a column, not a ring ──────────────────────── */
			@media (max-width: 760px) {
				html, body { overflow: auto; }
				.stage {
					position: relative;
					inset: auto;
					min-height: 100svh;
					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;
					gap: 26px;
					padding: 48px 28px 60px;
				}
				.centre { position: static; transform: none; width: 100%; }
				.buoy {
					position: static;
					transform: none;
					flex-direction: row;
					gap: 16px;
					width: min(260px, 80vw);
					cursor: pointer;
				}
				.float { width: 48px; height: 48px; animation-duration: 6s; }
				.glow { width: 56px; height: 14px; bottom: -10px; }
				.tag { font-size: 11px; }
				.reset { display: none; }
			}

			@media (prefers-reduced-motion: reduce) {
				.float { animation: none; }
				.stage, .float, .glow { transition: none; }
			}
		</style>

		<script is:inline>
			(function () {
				var canvas = document.getElementById('water');
				var stage  = document.getElementById('stage');
				var reset  = document.getElementById('reset');
				var buoys  = Array.prototype.slice.call(document.querySelectorAll('.buoy'));
				var STORE  = 'qw-buoys';
				var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				var phone   = function () { return window.matchMedia('(max-width: 760px)').matches; };

				// give each buoy its own rhythm so they don't pulse together
				buoys.forEach(function (b, i) {
					b.style.setProperty('--bob', (4.4 + i * 0.7) + 's');
					b.style.setProperty('--sway', (8.5 + i * 1.3) + 's');
					b.style.setProperty('--delay', (i * 0.9) + 's');
				});

				// ── remembered positions ──────────────────────────────
				function load() {
					try {
						var raw = localStorage.getItem(STORE);
						if (!raw) return;
						var saved = JSON.parse(raw);
						var any = false;
						buoys.forEach(function (b) {
							var p = saved[b.dataset.slug];
							if (p && typeof p.x === 'number' && typeof p.y === 'number') {
								b.style.setProperty('--x', p.x);
								b.style.setProperty('--y', p.y);
								any = true;
							}
						});
						if (any && reset) reset.hidden = false;
					} catch (e) {}
				}
				function save() {
					try {
						var out = {};
						buoys.forEach(function (b) {
							out[b.dataset.slug] = {
								x: parseFloat(b.style.getPropertyValue('--x')),
								y: parseFloat(b.style.getPropertyValue('--y')),
							};
						});
						localStorage.setItem(STORE, JSON.stringify(out));
						if (reset) reset.hidden = false;
					} catch (e) {}
				}
				load();

				if (reset) {
					reset.addEventListener('click', function () {
						try { localStorage.removeItem(STORE); } catch (e) {}
						window.location.reload();
					});
				}

					var VERT = [
						'attribute vec2 a_pos;',
						'varying vec2 vUv;',
						'void main() {',
						'  vUv = a_pos * 0.5 + 0.5;',
						'  gl_Position = vec4(a_pos, 0.0, 1.0);',
						'}'
					].join('\n');

					var FRAG = [
						'precision highp float;',
						'varying vec2 vUv;',
						'uniform float u_time;',
						'uniform vec2  u_res;',
						'uniform vec2  u_mouse;',
					'uniform vec2  u_pan;',
						'uniform vec4  u_ripples[6];',
						'uniform float u_dive;',
						'uniform float u_chop;',
						'',
						'vec3 mod289(vec3 x){ return x - floor(x * (1.0/289.0)) * 289.0; }',
						'vec2 mod289(vec2 x){ return x - floor(x * (1.0/289.0)) * 289.0; }',
						'vec3 permute(vec3 x){ return mod289(((x*34.0)+1.0)*x); }',
						'float snoise(vec2 v) {',
						'  const vec4 C = vec4(0.211324865405187, 0.366025403784439,',
						'                     -0.577350269189626, 0.024390243902439);',
						'  vec2 i  = floor(v + dot(v, C.yy));',
						'  vec2 x0 = v - i + dot(i, C.xx);',
						'  vec2 i1; i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);',
						'  vec4 x12 = x0.xyxy + C.xxzz; x12.xy -= i1;',
						'  i = mod289(i);',
						'  vec3 p = permute( permute( i.y + vec3(0.0, i1.y, 1.0))',
						'                          + i.x + vec3(0.0, i1.x, 1.0));',
						'  vec3 m = max(0.5 - vec3(dot(x0,x0), dot(x12.xy,x12.xy), dot(x12.zw,x12.zw)), 0.0);',
						'  m = m*m; m = m*m;',
						'  vec3 x = 2.0 * fract(p * C.www) - 1.0;',
						'  vec3 h = abs(x) - 0.5;',
						'  vec3 ox = floor(x + 0.5);',
						'  vec3 a0 = x - ox;',
						'  m *= 1.79284291400159 - 0.85373472095314 * (a0*a0 + h*h);',
						'  vec3 g;',
						'  g.x  = a0.x  * x0.x  + h.x  * x0.y;',
						'  g.yz = a0.yz * x12.xz + h.yz * x12.yw;',
						'  return 130.0 * dot(m, g);',
						'}',
						'',
						'float fbm(vec2 p) {',
						'  float v = 0.0;',
						'  float a = 0.5;',
						'  for(int i=0;i<5;i++) {',
						'    v += a * snoise(p);',
						'    p *= 2.02;',
						'    a *= 0.5;',
						'  }',
						'  return v;',
						'}',
						'',
						'void main() {',
						'  vec2 uv = vUv;',
						'  float aspect = u_res.x / u_res.y;',
						'',
						'  vec2 p = uv;',
						'  p.x *= aspect;',
						'  // descent — the surface draws away as you sink through it',
						'  p = (p - vec2(aspect * 0.5, 0.5)) * mix(1.0, 0.84, u_dive)',
						'      + vec2(aspect * 0.5, 0.5);',
					'  p += u_pan;   // the surface slides with the scene',
						'  float t = u_time * 0.10;',
						'',
						'  vec2 q;',
						'  q.x = fbm(p * 1.6 + vec2(0.0, t));',
						'  q.y = fbm(p * 1.6 + vec2(5.2, t * 1.2));',
						'',
						'  vec2 r;',
						'  r.x = fbm(p * 2.4 + 1.7 * q + vec2(1.7, 9.2) + t * 0.4);',
						'  r.y = fbm(p * 2.4 + 1.7 * q + vec2(8.3, 2.8) + t * 0.3);',
						'',
						'  float f = fbm(p * 1.4 + r);',
						'  f *= mix(1.0, 0.34, u_dive);   // turbulence stills"',
						'',
						'  // wrong password — the surface turns choppy',
						'  if (u_chop > 0.001) {',
						'    f += u_chop * snoise(p * 16.0 + vec2(u_time * 7.0)) * 0.30;',
						'  }',
						'',
						'  vec2 m = u_mouse;',
						'  m.x *= aspect;',
						'  float md = distance(p, m);',
						'  float mInf = exp(-md * 2.8) * 0.32;',
						'  f += mInf * sin(u_time * 1.2 - md * 7.5) * 0.22;',
						'',
						'  for (int i=0; i<6; i++) {',
						'    vec4 rp = u_ripples[i];',
						'    if (rp.w <= 0.0) continue;',
						'    vec2 rc = vec2(rp.x * aspect, rp.y);',
						'    float rd = distance(p, rc);',
						'    float age = u_time - rp.z;',
						'    float radius = age * 0.42;',
						'    float band = exp(-pow((rd - radius) * 14.0, 2.0));',
						'    float life = clamp(1.0 - age / 2.4, 0.0, 1.0);',
						'    f += band * life * rp.w * 0.55;',
						'  }',
						'',
						'  float caustic = abs(sin(f * 4.6 + u_time * 0.55));',
						'  caustic = pow(caustic, 16.0);',
						'',
						'  vec3 cA = vec3(0.047, 0.067, 0.141);',
						'  vec3 cB = vec3(0.078, 0.129, 0.239);',
						'  vec3 cC = vec3(0.122, 0.227, 0.427);',
						'  vec3 accent = vec3(0.427, 0.639, 1.0);',
						'',
						'  float g = smoothstep(-0.2, 0.6, f);',
						'  vec3 col = mix(cA, cB, g);',
						'  col = mix(col, cC, smoothstep(0.35, 0.95, g + length(r) * 0.18));',
						'',
						'  vec3 highlight = mix(vec3(1.0, 0.96, 0.88), accent, 0.20);',
						'  col += caustic * highlight * 0.10 * (1.0 - u_dive);',
						'  col += accent * mInf * 0.03;',
						'',
						'  // edge falloff',
						'  float vig = 1.0 - smoothstep(0.45, 1.30, length((uv - 0.5) * vec2(aspect, 1.0)));',
						'  col *= mix(0.70, 1.04, vig);',
						'',
						'  // a still pool in the middle, so the type always has somewhere to sit',
						'  float calm = 1.0 - smoothstep(0.04, 0.60, length((uv - 0.5) * vec2(aspect * 0.80, 1.0)));',
						'  col = mix(col, vec3(0.027, 0.043, 0.086), calm * 0.88);',
						'',
						'  float grain = (fract(sin(dot(uv.xy + u_time * 0.001, vec2(12.9898,78.233))) * 43758.5453) - 0.5);',
						'  col += grain * 0.012;',
						'',
						'  // the water closes over you',
						'  col = mix(col, vec3(0.010, 0.017, 0.038), smoothstep(0.0, 0.92, u_dive));',
						'',
						'  gl_FragColor = vec4(col, 1.0);',
						'}'
					].join('\n');

				var gl = null;
				try {
					gl = canvas.getContext('webgl', { antialias: true, alpha: false, powerPreference: 'high-performance' })
						|| canvas.getContext('experimental-webgl');
				} catch (e) { gl = null; }

				var U = {}, ripples = [];
				var mouse = { x: 0.5, y: 0.5, lx: 0.5, ly: 0.5 };
				var dive = 0, diveTarget = 0, chop = 0;
				var pan = { x: 0, y: 0 };
				var start = performance.now();
				var running = false, idleAt = performance.now();

				function compile(type, src) {
					var sh = gl.createShader(type);
					gl.shaderSource(sh, src);
					gl.compileShader(sh);
					if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
						console.warn(gl.getShaderInfoLog(sh)); return null;
					}
					return sh;
				}
				function resize() {
					var dpr = Math.min(window.devicePixelRatio || 1, phone() ? 1.25 : 2);
					var w = Math.floor(window.innerWidth * dpr);
					var h = Math.floor(window.innerHeight * dpr);
					if (canvas.width !== w || canvas.height !== h) {
						canvas.width = w; canvas.height = h;
						gl.viewport(0, 0, w, h);
					}
					gl.uniform2f(U.u_res, w, h);
				}
				function draw(elapsed) {
					gl.uniform1f(U.u_time, elapsed);
					gl.uniform2f(U.u_mouse, mouse.lx, mouse.ly);
					gl.uniform1f(U.u_dive, dive);
					gl.uniform1f(U.u_chop, chop);
					gl.uniform2f(U.u_pan, pan.x / window.innerWidth, -pan.y / window.innerHeight);
					for (var i = 0; i < 6; i++) {
						var rp = ripples[i];
						if (rp) gl.uniform4f(U.u_ripples[i], rp.x, rp.y, rp.t, rp.amp);
						else gl.uniform4f(U.u_ripples[i], 0, 0, 0, 0);
					}
					gl.drawArrays(gl.TRIANGLES, 0, 3);
				}
				function loop() {
					if (!running) return;
					var now = performance.now();
					var elapsed = (now - start) / 1000;
					mouse.lx += (mouse.x - mouse.lx) * 0.06;
					mouse.ly += (mouse.y - mouse.ly) * 0.06;
					dive += (diveTarget - dive) * 0.030;
					chop *= 0.94;
					ripples = ripples.filter(function (r) { return (elapsed - r.t) < 2.5; });
					draw(elapsed);

					// hold the last frame once nothing has happened for a while
					if (!diveTarget && now - idleAt > 30000) { running = false; return; }
					requestAnimationFrame(loop);
				}
				function wake() {
					idleAt = performance.now();
					if (!running && gl && !reduced) { running = true; requestAnimationFrame(loop); }
				}
				function rippleAt(x, y, amp) {
					var elapsed = (performance.now() - start) / 1000;
					ripples.push({ x: x, y: y, t: elapsed, amp: amp || 1 });
					if (ripples.length > 6) ripples.shift();
				}

				function boot() {
					if (!gl) return;
					var vs = compile(gl.VERTEX_SHADER, VERT);
					var fs = compile(gl.FRAGMENT_SHADER, FRAG);
					if (!vs || !fs) return;
					var prog = gl.createProgram();
					gl.attachShader(prog, vs); gl.attachShader(prog, fs);
					gl.linkProgram(prog);
					if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
						console.warn(gl.getProgramInfoLog(prog)); return;
					}
					gl.useProgram(prog);
					var buf = gl.createBuffer();
					gl.bindBuffer(gl.ARRAY_BUFFER, buf);
					gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
					var loc = gl.getAttribLocation(prog, 'a_pos');
					gl.enableVertexAttribArray(loc);
					gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
					['u_time','u_res','u_mouse','u_dive','u_chop','u_pan'].forEach(function (n) {
						U[n] = gl.getUniformLocation(prog, n);
					});
					U.u_ripples = [];
					for (var i = 0; i < 6; i++) U.u_ripples.push(gl.getUniformLocation(prog, 'u_ripples[' + i + ']'));
					resize();
					window.addEventListener('resize', function () { resize(); wake(); });
					canvas.classList.add('lit');
					if (reduced) { draw(6.0); return; }
					running = true;
					requestAnimationFrame(loop);
				}
				boot();

				window.addEventListener('mousemove', function (e) {
					mouse.x = e.clientX / window.innerWidth;
					mouse.y = 1 - e.clientY / window.innerHeight;
					wake();
				});
				window.addEventListener('keydown', wake);
				window.addEventListener('scroll', wake, { passive: true });
				window.addEventListener('touchstart', wake, { passive: true });

				// ── drag the water itself: the whole scene moves ─────
				var field = document.getElementById('field');
				var PAN_LIMIT = 0.18;            // fraction of the viewport

				(function () {
					var active = false, sx = 0, sy = 0, ox = 0, oy = 0;
					stage.addEventListener('pointerdown', function (e) {
						if (phone()) return;
						if (e.target.closest('.buoy') || e.target.closest('a') || e.target.closest('button')) return;
						active = true;
						sx = e.clientX; sy = e.clientY; ox = pan.x; oy = pan.y;
						stage.setPointerCapture(e.pointerId);
						document.body.classList.add('panning');
						wake();
					});
					stage.addEventListener('pointermove', function (e) {
						if (!active) return;
						var lx = window.innerWidth * PAN_LIMIT;
						var ly = window.innerHeight * PAN_LIMIT;
						pan.x = Math.max(-lx, Math.min(lx, ox + (e.clientX - sx)));
						pan.y = Math.max(-ly, Math.min(ly, oy + (e.clientY - sy)));
						if (field) field.style.transform = 'translate3d(' + pan.x + 'px,' + pan.y + 'px,0)';
						wake();
					});
					function stop(e) {
						if (!active) return;
						active = false;
						try { stage.releasePointerCapture(e.pointerId); } catch (_) {}
						document.body.classList.remove('panning');
					}
					stage.addEventListener('pointerup', stop);
					stage.addEventListener('pointercancel', stop);
				})();

				// ── drag, and the click hiding inside it ──────────────
				var DRAG_SLOP = 6;   // px before a press becomes a drag

				buoys.forEach(function (b) {
					var sx = 0, sy = 0, moved = false, active = false;

					b.addEventListener('pointerdown', function (e) {
						if (phone()) return;              // column layout: tap only
						e.stopPropagation();
						active = true; moved = false;
						sx = e.clientX; sy = e.clientY;
						b.setPointerCapture(e.pointerId);
						wake();
					});

					b.addEventListener('pointermove', function (e) {
						if (!active) return;
						var dx = e.clientX - sx, dy = e.clientY - sy;
						if (!moved && Math.hypot(dx, dy) < DRAG_SLOP) return;
						if (!moved) { moved = true; b.classList.add('dragging'); }
						e.preventDefault();
						var x = Math.max(4, Math.min(96, ((e.clientX - pan.x) / window.innerWidth) * 100));
						var y = Math.max(6, Math.min(94, ((e.clientY - pan.y) / window.innerHeight) * 100));
						b.style.setProperty('--x', x);
						b.style.setProperty('--y', y);
						chop = Math.min(1, chop + 0.05);
						rippleAt(x / 100, 1 - y / 100, 0.55);
						wake();
					});

					function release(e) {
						if (!active) return;
						active = false;
						try { b.releasePointerCapture(e.pointerId); } catch (_) {}
						if (moved) { b.classList.remove('dragging'); save(); }
					}
					b.addEventListener('pointerup', release);
					b.addEventListener('pointercancel', release);

					b.addEventListener('click', function (e) {
						if (moved) { e.preventDefault(); moved = false; return; }
						e.preventDefault();
						enter(b, b.getAttribute('href'));
					});
				});

				// ── the dive into a section ───────────────────────────
				var going = false;
				function enter(b, href) {
					if (going) return;
					going = true;
					var r = b.getBoundingClientRect();
					stage.style.setProperty('--ox', ((r.left + r.width / 2) / window.innerWidth) * 100 + '%');
					stage.style.setProperty('--oy', ((r.top + r.height / 2) / window.innerHeight) * 100 + '%');
					b.classList.add('chosen');
					rippleAt((r.left + r.width / 2) / window.innerWidth,
					         1 - (r.top + r.height / 2) / window.innerHeight, 1);
					document.body.classList.add('diving');
					diveTarget = 1;
					wake();
					if (reduced || !gl) { window.location.href = href; return; }
					setTimeout(function () { window.location.href = href; }, 760);
				}
			})();
		</script>
	</body>
</html>
