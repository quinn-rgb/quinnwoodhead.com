---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import stanfordMark from '../assets/brand/stanford.png';
import drakeMark from '../assets/brand/drake.jpg';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.jpg', { eager: true });
const shots = (slug: string) =>
	Object.entries(files)
		.filter(([k]) => k.split('/').pop()!.startsWith(slug))
		.sort(([a], [b]) => a.localeCompare(b))
		.map(([, m]) => m.default);

const featured = [
	{ slug: 'mobi',             title: 'Mobi',              kind: 'Portable foam roller' },
	{ slug: 'oyster-shucker',   title: 'Oyster Shucker',    kind: 'Tool redesign · steel, resin, CAD' },
	{ slug: 'blocker',          title: 'The Blocker',       kind: 'Training hardware · rowing' },
	{ slug: 'laser-cut-box',    title: 'Laser-Cut Box',     kind: 'Fabrication · joinery, tolerances' },
	{ slug: 'pulling-robot',    title: 'The Pulling Robot', kind: 'Robotics · Arduino, servos, welding' },
	{ slug: 'bridge',           title: 'Building a Bridge', kind: 'Structural engineering' },
	{ slug: 'mechanism',        title: 'Raising a Load',    kind: 'Mechanism · gears, linkages' },
	{ slug: 'bi-stable-switch', title: 'Bi-Stable Switch',  kind: 'Mechanism · snap-fit, ABS' },
	{ slug: 'air-cam',          title: 'The Air Cam',       kind: 'Aerial hardware · stabilization' },
].map((p) => ({ ...p, images: shots(p.slug) })).filter((p) => p.images.length);

const alsoRan = ['Unison', 'Empowered Education', 'IDEA App', 'Ceramics Stamp'];

const education = [
	{ when: '2022', what: 'Stanford University',
	  where: 'B.S. Product Design · School of Engineering', mark: stanfordMark },
	{ when: '2018', what: 'Sir Francis Drake High School',
	  where: 'San Anselmo, California', mark: drakeMark },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Projects — Quinn Woodhead" description="Quinn Woodhead." />
	</head>
	<body data-page="projects">
		<Nav />
		<main>
			<h1>Projects</h1>

			<div class="grid">
				{featured.map((p, i) => (
					<article class="card">
						<div class="frame">
							<Image src={p.images[0]} alt={p.title} widths={[400, 800, 1200]}
								sizes="(max-width: 760px) 92vw, 44vw" loading={i < 2 ? 'eager' : 'lazy'} />
							<span class="idx">{String(i + 1).padStart(2, '0')}</span>
						</div>
						<h3>{p.title}</h3>
						<span class="where">{p.kind}</span>
						{p.images.length > 1 && (
							<div class="strip">
								{p.images.slice(1, 5).map((img) => (
									<Image src={img} alt="" widths={[160, 320]} sizes="56px" loading="lazy" />
								))}
							</div>
						)}
					</article>
				))}
			</div>

			<h2>Also</h2>
			<p class="also">{alsoRan.join(' · ')}</p>

			<h2>Education</h2>
			<div class="rows">
				{education.map((e) => (
					<div class="row">
						<div class="when">{e.when}</div>
						<div class="what school">
							<span class="crest"><Image src={e.mark} alt="" widths={[90, 180]} sizes="44px" loading="lazy" /></span>
							<div>
								<h3>{e.what}</h3>
								<span class="where">{e.where}</span>
							</div>
						</div>
					</div>
				))}
			</div>
		</main>
		<Footer />

		<style>
			.grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 46px 36px;
			}
			.card h3 { margin-top: 15px; font-size: 19px; }
			.card .where { margin-top: 6px; }

			.frame {
				position: relative;
				aspect-ratio: 3 / 2;
				overflow: hidden;
				border-radius: 12px;
				border: 1px solid var(--line);
				background: var(--bg-2);
			}
			.frame :global(img) {
				width: 100%; height: 100%; object-fit: cover; display: block;
				transition: transform 700ms cubic-bezier(.2,.6,.2,1);
			}
			.card:hover .frame :global(img) { transform: scale(1.04); }

			.idx {
				position: absolute;
				top: 10px; left: 12px;
				font-family: var(--mono);
				font-size: 10px;
				letter-spacing: 0.1em;
				color: var(--fg);
				background: rgba(7, 11, 22, 0.66);
				border: 1px solid var(--line-2);
				border-radius: 20px;
				padding: 3px 9px;
				backdrop-filter: blur(6px);
			}

			.strip { display: flex; gap: 6px; margin-top: 13px; }
			.strip :global(img) {
				width: 56px; height: 42px; object-fit: cover;
				border-radius: 4px; border: 1px solid var(--line);
				opacity: 0.5; transition: opacity 260ms ease;
			}
			.card:hover .strip :global(img) { opacity: 1; }

			@media (max-width: 760px) {
				.grid { grid-template-columns: 1fr; gap: 34px; }
			}

			.also { font-size: 15px; color: var(--fg-3); }
			.school { display: flex; align-items: center; gap: 16px; }
			.crest {
				flex: none; width: 46px; height: 46px;
				display: flex; align-items: center; justify-content: center;
				border-radius: 9px; background: #f4f6fa;
				border: 1px solid var(--line); overflow: hidden;
			}
			.crest :global(img) { width: 32px; height: 32px; object-fit: contain; display: block; }
		</style>
	</body>
</html>
