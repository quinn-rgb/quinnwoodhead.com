---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import stanfordMark from '../assets/brand/stanford.png';
import drakeMark from '../assets/brand/drake.jpg';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.jpg', { eager: true });
const shots = (slug: string) =>
	Object.entries(files)
		.filter(([k]) => k.split('/').pop()!.startsWith(slug))
		.sort(([a], [b]) => a.localeCompare(b))
		.map(([, m]) => m.default);

const featured = [
	{ slug: 'mobi',             title: 'Mobi',              kind: 'Portable foam roller' },
	{ slug: 'oyster-shucker',   title: 'Oyster Shucker',    kind: 'Tool redesign · steel, resin, CAD' },
	{ slug: 'blocker',          title: 'The Blocker',       kind: 'Training hardware · rowing' },
	{ slug: 'laser-cut-box',    title: 'Laser-Cut Box',     kind: 'Fabrication · joinery, tolerances' },
	{ slug: 'pulling-robot',    title: 'The Pulling Robot', kind: 'Robotics · Arduino, servos, welding' },
	{ slug: 'bridge',           title: 'Building a Bridge', kind: 'Structural engineering' },
	{ slug: 'mechanism',        title: 'Raising a Load',    kind: 'Mechanism · gears, linkages' },
	{ slug: 'bi-stable-switch', title: 'Bi-Stable Switch',  kind: 'Mechanism · snap-fit, ABS' },
	{ slug: 'air-cam',          title: 'The Air Cam',       kind: 'Aerial hardware · stabilization' },
].map((p) => ({ ...p, images: shots(p.slug) })).filter((p) => p.images.length);

const alsoRan = ['Unison', 'Empowered Education', 'IDEA App', 'Ceramics Stamp'];

const education = [
	{ when: '2022', what: 'Stanford University',
	  where: 'B.S. Product Design · School of Engineering', mark: stanfordMark },
	{ when: '2018', what: 'Sir Francis Drake High School',
	  where: 'San Anselmo, California', mark: drakeMark },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Work — Quinn Woodhead" description="Quinn Woodhead." />
	</head>
	<body data-page="work">
		<Nav />
		<main>
			<h1>Work</h1>

			<div class="reel">
				{featured.map((p, i) => (
					<article class="piece" style={`--i: ${i}`}>
						<div class="shot">
							<Image src={p.images[0]} alt={p.title} widths={[600, 1000, 1600]}
								sizes="(max-width: 820px) 92vw, 58vw" loading={i < 2 ? 'eager' : 'lazy'} />
						</div>
						<div class="say">
							<span class="idx">{String(i + 1).padStart(2, '0')}</span>
							<h3>{p.title}</h3>
							<span class="where">{p.kind}</span>
							{p.images.length > 1 && (
								<div class="strip">
									{p.images.slice(1, 5).map((img) => (
										<Image src={img} alt="" widths={[200, 400]} sizes="72px" loading="lazy" />
									))}
								</div>
							)}
						</div>
					</article>
				))}
			</div>

			<h2>Also</h2>
			<p class="also">{alsoRan.join(' · ')}</p>

			<h2>Education</h2>
			<div class="rows">
				{education.map((e) => (
					<div class="row">
						<div class="when">{e.when}</div>
						<div class="what school">
							<span class="crest"><Image src={e.mark} alt="" widths={[90, 180]} sizes="44px" loading="lazy" /></span>
							<div>
								<h3>{e.what}</h3>
								<span class="where">{e.where}</span>
							</div>
						</div>
					</div>
				))}
			</div>
		</main>
		<Footer />

		<style>
			.reel { display: flex; flex-direction: column; gap: 56px; }

			.piece {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
				gap: 36px;
				align-items: center;
				/* narrower than the column and alternating sides, so the stagger
				   is in the page too, not only inside each row */
				max-width: 880px;
				margin-right: auto;
			}
			.piece:nth-child(even) { margin-right: 0; margin-left: auto; }
			/* every other one flips, so the eye zig-zags down the page */
			.piece:nth-child(even) .shot { order: 2; }
			.piece:nth-child(even) .say  { order: 1; text-align: right; }
			.piece:nth-child(even) .strip { justify-content: flex-end; }

			.shot {
				position: relative;
				aspect-ratio: 3 / 2;
				overflow: hidden;
				border-radius: 14px;
				border: 1px solid var(--line);
				background: var(--bg-2);
			}
			.shot :global(img) {
				width: 100%; height: 100%; object-fit: cover; display: block;
				transition: transform 900ms cubic-bezier(.2,.6,.2,1);
			}
			.piece:hover .shot :global(img) { transform: scale(1.04); }

			.say { position: relative; }
			.idx {
				display: block;
				font-family: var(--serif);
				font-size: clamp(40px, 4.6vw, 62px);
				line-height: 0.8;
				color: rgba(var(--accent-rgb), 0.16);
				margin-bottom: 10px;
				user-select: none;
			}
			.say h3 { font-size: clamp(19px, 2.1vw, 24px); }
			.say .where { margin-top: 10px; }

			.strip { display: flex; gap: 7px; margin-top: 20px; }
			.strip :global(img) {
				width: 62px; height: 46px; object-fit: cover;
				border-radius: 5px; border: 1px solid var(--line);
				opacity: 0.55; transition: opacity 260ms ease;
			}
			.piece:hover .strip :global(img) { opacity: 1; }

			@media (max-width: 820px) {
				.reel { gap: 54px; }
				.piece { grid-template-columns: 1fr; gap: 20px; }
				.piece:nth-child(even) .shot { order: 0; }
				.piece:nth-child(even) .say  { order: 0; text-align: left; }
				.piece:nth-child(even) .strip { justify-content: flex-start; }
				.idx { font-size: 48px; margin-bottom: 8px; }
			}

			.also { font-size: 15px; color: var(--fg-3); }
			.school { display: flex; align-items: center; gap: 16px; }
			.crest {
				flex: none; width: 46px; height: 46px;
				display: flex; align-items: center; justify-content: center;
				border-radius: 9px; background: #f4f6fa;
				border: 1px solid var(--line); overflow: hidden;
			}
			.crest :global(img) { width: 32px; height: 32px; object-fit: contain; display: block; }
		</style>
	</body>
</html>
