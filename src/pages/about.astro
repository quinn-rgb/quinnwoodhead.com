---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait/grad-1.jpg';
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const education = [
	{ when: '2022', what: 'Stanford University', where: 'B.S. Product Design · School of Engineering' },
	{ when: '2018', what: 'Sir Francis Drake High School', where: 'San Anselmo, California' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About — Quinn Woodhead" description="Quinn Woodhead." />
	</head>
	<body data-page="about">
		<Nav />
		<main>
			<h1>About</h1>

			<figure class="portrait">
				<Image src={portrait} alt="Quinn Woodhead" widths={[300, 600]} sizes="190px" loading="eager" />
			</figure>

			<p class="lead">
				I&rsquo;m Quinn — a Stanford-trained product designer, a water polo player on the
				USA National Team, and currently on the go-to-market team at Anthropic.
			</p>
			<p>
				I spent the years after Stanford competing internationally — pro seasons in Greece
				and Italy, alternate for the 2024 Paris Olympics — while making things on the side.
				Outside of work I&rsquo;m still in the pool, still designing, still making things by hand.
			</p>

			<h2>Education</h2>
			<div class="rows">
				{education.map((e) => (
					<div class="row">
						<div class="when">{e.when}</div>
						<div class="what">
							<h3>{e.what}</h3>
							<span class="where">{e.where}</span>
						</div>
					</div>
				))}
			</div>

			<h2>What I do</h2>
			<p>
				End-to-end product design: need-finding, sketching, CAD, prototyping, and the
				visual communication that carries an idea. I&rsquo;m drawn to physical things that
				solve a small real problem cleanly.
			</p>
		</main>
		<Footer />
		<style>
			.portrait {
				float: right;
				margin: 4px 0 20px 28px;
				width: 190px;
			}
			.portrait :global(img) {
				width: 100%;
				height: 240px;
				object-fit: cover;
				border-radius: 10px;
				border: 1px solid var(--line);
				display: block;
			}
			@media (max-width: 560px) {
				.portrait { float: none; margin: 0 0 24px; width: 150px; }
				.portrait :global(img) { height: 190px; }
			}
		</style>
	</body>
</html>
