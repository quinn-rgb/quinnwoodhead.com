---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

import portrait from '../assets/portrait/grad-1.jpg';
import dayOne from '../assets/life/anthropic-day-one.jpg';
import signature from '../assets/brand/signature.png';

import athens from '../assets/life/athens-hill.jpg';
import underwater from '../assets/life/underwater.jpg';
import cliffs from '../assets/life/cliffs-turquoise.jpg';
import island from '../assets/life/island.jpg';
import hiking from '../assets/life/hiking.jpg';
import workshop from '../assets/life/workshop-build.jpg';
import shooting from '../assets/life/shooting.jpg';
import sunsetSwim from '../assets/life/sunset-swim.jpg';

const rail = [portrait, athens, underwater, workshop, shooting, cliffs, island, hiking, sunsetSwim];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About — Quinn Woodhead" description="Quinn Woodhead." />
	</head>
	<body data-page="about">
		<Nav />
		<main>
			<h1>About</h1>

			<figure class="sign">
				<Image src={signature} alt="Quinn Woodhead" widths={[400, 800]} sizes="260px" loading="eager" />
			</figure>

			<div class="layout">
				<div class="words">
					<p class="lead">
						I&rsquo;m Quinn — a Stanford-trained product designer, a water polo player on the
						USA National Team, and currently on the go-to-market team at Anthropic.
					</p>
					<p>
						I grew up in Northern California and started playing water polo at Drake in 2013.
						The sport took me to Stanford, where I captained the team for three years, won an
						NCAA title as a sophomore, and finished a B.S. in Product Design at the School of
						Engineering.
					</p>
					<p>
						After graduating I went to Europe to play professionally — ANO Glyfada outside
						Athens from January 2023, then Telimar in Palermo and Roma Vis Nova. I debuted
						for the senior national team the same year: gold at the Pan-American Games in
						Santiago, bronze at the World Cup, and an alternate spot for the Paris Olympics
						in 2024.
					</p>

					<h2>Now</h2>
					<p>
						San Francisco, on the go-to-market team at Anthropic. Still in the pool most
						mornings, still coaching, still making things at the weekend.
					</p>

					<h2>Design and sport pull on the same thread</h2>
					<p>
						Both reward the same things: repetition, noticing small details nobody else will
						notice, and being willing to do the unglamorous part over and over until it&rsquo;s
						right. A play you run two hundred times in practice and a part you print for the
						twelfth time are the same kind of patience.
					</p>
					<p>
						I design products end to end — need-finding and user research, sketching, CAD,
						prototyping, and the visual communication that carries an idea to someone else.
						I&rsquo;m drawn to physical things that solve a small real problem cleanly, and to
						teams that take creativity, sustainability and collaboration seriously.
					</p>

					<h2>Away from both</h2>
					<p>
						I&rsquo;m usually making something with my hands — throwing bowls, printing parts,
						drawing, or photographing wherever I&rsquo;ve ended up. Three seasons living out of a
						bag in Greece and Italy turned out to be good for that. Still in the pool most
						mornings, still designing, still making things by hand.
					</p>

				</div>

				<aside class="rail">
					<figure class="portrait">
						<Image src={dayOne} alt="First day at Anthropic, San Francisco"
							widths={[400, 800]} sizes="300px" loading="eager" />
						<figcaption>First day · Anthropic · San Francisco</figcaption>
					</figure>
					<div class="thumbs">
						{rail.map((img) => (
							<figure>
								<Image src={img} alt="" widths={[200, 400]} sizes="145px" loading="lazy" />
							</figure>
						))}
					</div>
				</aside>
			</div>
		</main>
		<Footer />

		<style>
			.layout {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 300px;
				gap: 56px;
				align-items: start;
			}
			.words p { max-width: 64ch; }
			.words h2:first-of-type { margin-top: 52px; }

			.rail { display: flex; flex-direction: column; gap: 10px; }
			.rail figure { margin: 0; }

			.portrait {
				aspect-ratio: 4 / 5;
				overflow: hidden;
				border-radius: 12px;
				border: 1px solid var(--line);
				background: var(--bg-2);
				position: relative;
			}
			.portrait figcaption {
				position: absolute;
				left: 0; right: 0; bottom: 0;
				padding: 22px 12px 10px;
				font-family: var(--mono);
				font-size: 9px;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: rgba(255, 255, 255, 0.82);
				background: linear-gradient(to top, rgba(7,11,22,0.82), transparent);
			}
			.thumbs {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 10px;
			}
			.thumbs figure {
				aspect-ratio: 1 / 1;
				overflow: hidden;
				border-radius: 9px;
				border: 1px solid var(--line);
				background: var(--bg-2);
			}
			.rail :global(img) {
				width: 100%; height: 100%; object-fit: cover; display: block;
				transition: transform 600ms cubic-bezier(.2,.6,.2,1);
			}
			.rail figure:hover :global(img) { transform: scale(1.05); }

			.sign { margin: -14px 0 34px; }
			.sign :global(img) {
				width: clamp(170px, 20vw, 230px); height: auto; display: block;
				filter: invert(1);
				mix-blend-mode: screen;
				opacity: 0.62;
			}

			@media (max-width: 900px) {
				.layout { grid-template-columns: 1fr; gap: 36px; }
				.rail { max-width: 420px; }
				.thumbs { grid-template-columns: repeat(4, 1fr); }
			}
		</style>
	</body>
</html>
