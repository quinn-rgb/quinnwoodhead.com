---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

import stanfordMark from '../assets/brand/stanford.png';
import drakeMark from '../assets/brand/drake.jpg';
import usawpMark from '../assets/brand/usawp.jpg';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/athletics/*.jpg', { eager: true });
const pic = (name: string) =>
	Object.entries(files).find(([k]) => k.endsWith('/' + name + '.jpg'))?.[1].default;

const hero = pic('panam-2023-anthem');
const crests: Record<string, ImageMetadata | null> =
	{ usa: usawpMark, stanford: stanfordMark, drake: drakeMark, pro: null };

const milestones = [
	{ when: '2023–25', org: 'pro', what: 'Pro water polo', where: 'Glyfada · Telimar · Roma Vis Nova',
	  note: 'Three seasons in Europe — ANO Glyfada outside Athens from January 2023, then Telimar in Palermo and Roma Vis Nova.',
	  shots: ['pro-telimar', 'pro-1', 'pro-2', 'pro-3', 'pro-4', 'pro-team'] },
	{ when: '2024', org: 'usa', what: 'Paris alternate', where: 'USA National Team',
	  note: 'Alternate for the Paris Olympics.',
	  shots: ['usa-team-photo'] },
	{ when: '2023', org: 'usa', what: 'National team debut', where: 'USA National Team',
	  note: 'First senior caps for the USA. Gold at the Pan-American Games in Santiago, bronze at the World Cup.',
	  shots: ['usa-v-china-2023', 'team-usa-flag'] },
	{ when: '2019', org: 'stanford', what: 'NCAA National Champions', where: 'Stanford',
	  note: 'Stanford takes the title. ACWPC All-American as a sophomore.',
	  shots: ['ncaa-2019-trophy', 'ncaa-celebration', 'trophy-kiss', 'stanford-match-1'] },
	{ when: '2019', org: 'usa', what: 'Summer Universiade', where: 'Napoli · Italy',
	  note: 'International competition with the USA collegiate squad.',
	  shots: ['napoli-2019', 'universiade-bench'] },
	{ when: '2018', org: 'stanford', what: 'Joined Stanford', where: 'Stanford',
	  note: 'First college season with the men’s water polo team. Three years as captain, four-time ACWPC All-American, and 1st Team in 2022.',
	  shots: ['shooting-red-cap-1', 'shooting-red-cap-2', 'stanford-arm-raised', 'stanford-celebrate', 'pool-celebration', 'stanford-shot'] },
	{ when: '2017', org: 'drake', what: 'NorCal Champions', where: 'Drake High School',
	  note: 'CIF NCS Division 1. NISCA 1st Team All-American. MCAL Player of the Year.',
	  shots: ['match-wide', 'team-huddle'] },
].map((m) => ({ ...m, images: m.shots.map(pic).filter(Boolean) as ImageMetadata[] }));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Athletics — Quinn Woodhead" description="Quinn Woodhead." />
	</head>
	<body data-page="athletics">
		<Nav />

		{hero && (
			<div class="hero">
				<Image src={hero} alt="USA Men's National Team, Pan-American Games, Santiago 2023"
					widths={[900, 1600, 2200]} sizes="100vw" loading="eager" />
				<!-- Everyone goes blue; the window leaves the fourth man from the
				     left in his own colour. -->
				<div class="pick"></div>
				<div class="veil"></div>
			</div>
		)}

		<main>
			<h1>Athletics</h1>
			<p class="lead">
				Water polo since 2013 — Drake, Stanford, three pro seasons in Europe, and the
				USA National Team.
			</p>

			<div class="rows">
				{milestones.map((m) => (
					<div class="row">
						<div class="when">{m.when}</div>
						<div class="what">
							<h3>
								{crests[m.org] && (
									<span class="crest"><Image src={crests[m.org]!} alt="" widths={[80, 160]} sizes="28px" loading="lazy" /></span>
								)}
								{m.what}
							</h3>
							<p>{m.note}</p>
							<span class="where">{m.where}</span>
							{m.images.length > 0 && (
								<div class="shots">
									{m.images.map((img) => (
										<Image src={img} alt={m.what} widths={[300, 600]}
											sizes="(max-width: 600px) 45vw, 180px" loading="lazy" />
									))}
								</div>
							)}
						</div>
					</div>
				))}
			</div>
		</main>
		<Footer />

		<style>
			.hero {
				position: relative;
				height: clamp(300px, 48vh, 480px);
				margin-top: -74px;
				overflow: hidden;
			}
			.hero :global(img) {
				width: 100%; height: 100%; display: block;
				object-fit: cover;
				/* anchored near the top so the line-up's faces clear the bar */
				object-position: 50% 4%;
			}
			.pick {
				position: absolute;
				inset: 0;
				background: #2a62c8;
				mix-blend-mode: color;
				opacity: 0.62;
				-webkit-mask-image: linear-gradient(to right,
					#000 0%, #000 53%, rgba(0,0,0,0) 57%,
					rgba(0,0,0,0) 65%, #000 69%, #000 100%);
				mask-image: linear-gradient(to right,
					#000 0%, #000 53%, rgba(0,0,0,0) 57%,
					rgba(0,0,0,0) 65%, #000 69%, #000 100%);
			}
			.veil {
				position: absolute;
				inset: 0;
				background: linear-gradient(to bottom,
					rgba(7,11,22,0.72) 0%, rgba(7,11,22,0.12) 38%, var(--bg) 97%);
			}
			main { padding-top: 40px; }

			h3 { display: flex; align-items: center; gap: 10px; }
			.crest {
				flex: none;
				width: 32px; height: 32px;
				display: inline-flex; align-items: center; justify-content: center;
				border-radius: 7px;
				background: #f4f6fa;
				border: 1px solid var(--line);
				overflow: hidden;
			}
			.crest :global(img) { width: 23px; height: 23px; object-fit: contain; display: block; }

			.shots {
				display: flex;
				gap: 8px;
				margin-top: 14px;
				flex-wrap: wrap;
			}
			.shots :global(img) {
				width: 180px;
				height: 122px;
				object-fit: cover;
				border-radius: 8px;
				border: 1px solid var(--line);
				transition: transform 500ms cubic-bezier(.2,.6,.2,1), border-color 300ms ease;
			}
			.shots :global(img:hover) {
				transform: scale(1.03);
				border-color: rgba(var(--accent-rgb), 0.55);
			}
			@media (max-width: 600px) {
				.shots :global(img) { width: calc(50% - 4px); height: 100px; }
			}
		</style>
	</body>
</html>
